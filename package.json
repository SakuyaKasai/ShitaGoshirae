{
  "name": "jes-formatter",
  "version": "1.0.0",
  "description": "論文原稿を日本人間工学会『人間工学』誌 技術報告テンプレートの体裁へ整えるWebアプリ",
  "type": "module",
  "private": true,
  "scripts": {
    "manifest": "node tools/build-manifest.mjs template.docx src/manifest.json",
    "build": "node tools/build-bundle.mjs",
    "fixture": "python3 tools/make-fixture.py fixture-source.docx",
    "fixture:full": "python3 tools/make-fixture-full.py fixture-full.docx",
    "test": "node test/run-all.mjs"
  },
  "dependencies": { "jszip": "^3.10.1" },
  "devDependencies": { "esbuild": "^0.28.2", "playwright": "^1.56.0" }
}
